{
  "name": "firestore",
  "version": "1.0.0",
  "description": "Interact with documents stored in a Firestore database using natural language.",
  "mcpServers": {
    "firestore": {
      "httpUrl": "https://firestore.googleapis.com/mcp",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/cloud-platform"]
      },
      "timeout": 30000
    }
  }
}
