{
  "name": "memorystore-for-valkey",
  "version": "1.0.0",
  "description": "Manage Memorystore for Valkey instances and backups using natural language.",
  "mcpServers": {
    "memorystore-for-valkey": {
      "httpUrl": "https://memorystore.googleapis.com/mcp",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/memorystore.read-write"]
      },
      "timeout": 30000
    }
  }
}
