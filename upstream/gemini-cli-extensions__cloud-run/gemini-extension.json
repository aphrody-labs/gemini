{
  "name": "cloud-run",
  "version": "1.0.0",
  "description": "Deploy apps to Cloud Run using natural language.",
  "mcpServers": {
    "cloud-run": {
      "httpUrl": "https://run.googleapis.com/mcp",
      "authProviderType": "google_credentials",
      "oauth": {
        "scopes": ["https://www.googleapis.com/auth/run"]
      },
      "timeout": 30000
    }
  }
}
