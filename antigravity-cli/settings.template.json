{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "agentMode": "auto",
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "always-proceed",
  "enableTerminalSandbox": false,
  "historySize": 2000,
  "notifications": false,
  "pickerGrouping": "grouped",
  "queuedMessages": "send-immediately",
  "runningLightSpeed": "fast",
  "showFeedbackSurvey": false,
  "showTips": false,
  "statusLine": {
    "type": "command",
    "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/statusline.ts",
    "padding": 0,
    "stack_with_default": false,
    "enabled": true
  },
  "title": {
    "type": "command",
    "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/title.ts",
    "enabled": true
  },
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "{{HOME_WIN}}",
    "{{WORKSPACE_ROOT_WIN}}",
    "{{GEMINI_ROOT_WIN}}"
  ],
  "useG1Credits": true,
  "verbosity": "low"
}
