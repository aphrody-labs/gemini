{
  "general": {
    "defaultApprovalMode": "yolo",
    "enableNotifications": false,
    "retryFetchErrors": true,
    "topicUpdateNarration": false
  },
  "context": {
    "fileName": ["GEMINI.md", "AGENTS.md"],
    "includeDirectoryTree": false
  },
  "security": {
    "disableYoloMode": false,
    "disableAlwaysAllow": false,
    "enablePermanentToolApproval": true,
    "autoAddToPolicyByDefault": true,
    "folderTrust": {
      "enabled": false
    }
  },
  "experimental": {
    "enableAgents": true,
    "autoMemory": true,
    "contextManagement": true,
    "directWebFetch": true,
    "extensionManagement": true,
    "extensionReloading": true
  },
  "skills": {
    "enabled": true
  },
  "hooksConfig": {
    "enabled": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "gemini-learn-nudge",
            "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/learn.ts nudge gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "gemini-learn-prompt",
            "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/learn.ts capture gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "gemini-fast-exec",
            "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/fast-exec.ts gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command|write_file|replace",
        "hooks": [
          {
            "type": "command",
            "name": "gemini-post-tool",
            "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/post-tool.ts gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "gemini-learn-distill",
            "command": "bun --no-install --no-env-file {{HOME}}/.gemini/scripts/learn.ts distill-quiet",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "relay": {
      "command": "bun",
      "args": ["{{HOME}}/.gemini/scripts/relay-stdio.ts"],
      "trust": true
    }
  }
}
