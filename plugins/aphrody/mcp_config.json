{
  "mcpServers": {
    "os-craft": {
      "command": "bun",
      "args": [
        "${PLUGIN_ROOT}/scripts/os-craft-mcp.ts"
      ]
    },
    "bun-brain": {
      "command": "bun",
      "args": [
        "--no-install",
        "--no-env-file",
        "${PLUGIN_ROOT}/mcp/bun-mcp.ts"
      ]
    },
    "nextjs-brain": {
      "command": "bun",
      "args": [
        "--no-install",
        "--no-env-file",
        "${PLUGIN_ROOT}/mcp/nextjs-mcp.ts"
      ]
    },
    "docker-docs": {
      "type": "http",
      "url": "https://ai-backend-service.docker.com/mcp"
    }
  }
}
