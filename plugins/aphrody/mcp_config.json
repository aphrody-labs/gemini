{
  "mcpServers": {
    "os-craft": {
      "command": "bun",
      "args": [
        "${PLUGIN_ROOT}/scripts/os-craft-mcp.ts"
      ]
    },
    "bun-brain": {
      "command": "bun",
      "args": [
        "--no-install",
        "--no-env-file",
        "${PLUGIN_ROOT}/mcp/bun-mcp.ts"
      ]
    },
    "nextjs-brain": {
      "command": "bun",
      "args": [
        "--no-install",
        "--no-env-file",
        "${PLUGIN_ROOT}/mcp/nextjs-mcp.ts"
      ]
    },
    "docker-docs": {
      "serverUrl": "https://ai-backend-service.docker.com/mcp"
    },
    "ovh-domain": {
      "serverUrl": "https://mcp.eu.ovhcloud.com/mcp/v1_domain"
    },
    "ovh-vps": {
      "serverUrl": "https://mcp.eu.ovhcloud.com/mcp/v1_vps"
    },
    "ovh-ip": {
      "serverUrl": "https://mcp.eu.ovhcloud.com/mcp/v1_ip"
    },
    "ovh-cloud": {
      "serverUrl": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud"
    },
    "ovh-cloud-instance": {
      "serverUrl": "https://mcp.eu.ovhcloud.com/mcp/v1_cloud_instance"
    }
  }
}
